# Puerto donde escuchará el servidor Express
PORT=4000

# Identificador del proyecto de Firebase (se puede inferir desde el service account)
FIREBASE_PROJECT_ID=conpatas-f7d07

# URL de la base de datos si usas Realtime Database. Para Firestore no es obligatorio.
FIREBASE_DATABASE_URL=https://conpatas-f7d07-default-rtdb.firebaseio.com

# Opciones para proveer las credenciales de Firebase Admin (usa solo una):
# 1) Ruta al archivo JSON dentro del proyecto
FIREBASE_SERVICE_ACCOUNT_FILE=backend/serviceAccount.json
# 2) JSON completo en una variable de entorno
FIREBASE_SERVICE_ACCOUNT_JSON=
# 3) El mismo JSON codificado en base64
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Configuración de SendGrid para enviar correos (opcional pero recomendado)
SENDGRID_API_KEY=
EMAIL_FROM=adopciones@tu-dominio.com

# Límite de tamaño para el body JSON (por defecto 1mb)
REQUEST_LIMIT=1mb
